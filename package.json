{
  "name": "sneaks-community-website",
  "version": "1.3.1",
  "description": "A lightweight landing page for gaming communities.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sneaks-Community/sneaks-community-website.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "npm run build:lib && npm run build:motion && npm run build:css && npm run build:js",
    "build:lib": "mkdir -p public/lib public/fonts && cp node_modules/@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2 public/fonts/space-grotesk.woff2 && cp node_modules/@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2 public/fonts/manrope.woff2",
    "build:motion": "esbuild src/motion-entry.js --bundle --format=iife --minify --outfile=public/lib/motion.js",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/tailwind.css --minify",
    "build:js": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --minify --outdir=dist",
    "start": "node --env-file=.env dist/index.js",
    "clean": "rm -rf dist && rm -f public/tailwind.css && rm -f public/lib/*.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "gamedig": "^5.3.3",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/gamedig": "^5.0.3",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.8.0",
    "motion": "^12.43.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.1": true
  }
}
