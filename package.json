{
  "name": "sneaks-community-website",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "npm run build:lib && npm run build:css && npm run build:js",
    "build:lib": "mkdir -p public/lib && cp node_modules/motion/dist/motion.js public/lib/motion.js && cp node_modules/lucide/dist/umd/lucide.js public/lib/lucide.js",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/tailwind.css --minify",
    "build:js": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --minify --outdir=dist",
    "start": "node --env-file=.env dist/index.js",
    "clean": "rm -rf dist && rm -f public/tailwind.css && rm -f public/lib/*.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "gamedig": "^5.3.3",
    "helmet": "^8.2.0",
    "node-cache": "^5.1.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/gamedig": "^5.0.3",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "lucide": "^1.16.0",
    "motion": "^12.40.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0"
  }
}
