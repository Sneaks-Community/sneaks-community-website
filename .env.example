NODE_ENV=production
LOG_LEVEL=info
COMMUNITY_NAME=Your Community Name
COMMUNITY_ESTABLISHED=2015
STEAM_LINK=https://steamcommunity.com/groups/yourlinkhere
TWITCH_LINK=https://twitch.tv/yourlinkhere
GITHUB_LINK=https://github.com/yourlinkhere
DISCORD_LINK=https://discord.gg/yourinvitehere
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
# Trust the X-Forwarded-For header for client IP (rate limiting, /health guard).
# ONLY enable behind a trusted reverse proxy — otherwise clients can spoof their IP.
# false (default) | true | hop count e.g. 1 | comma-separated IP/CIDR list.
TRUST_PROXY=false

# Canonical site origin (no trailing slash). Fills canonical/OpenGraph/Twitter URLs,
# the absolute og:image URL, and the robots.txt / sitemap.xml links.
SITE_URL=https://yourdomain.com
# SEO metadata (used in <meta description>, OpenGraph and Twitter tags).
META_DESCRIPTION=Your community tagline for search engines and social embeds.
META_KEYWORDS=gaming, community, your keywords here
# External resource-card links (Player Statistics / Ban List).
STATS_LINK=https://stats.yourdomain.com
BANS_LINK=https://bans.yourdomain.com
# Identity-specific page copy.
HERO_TAGLINE=An open and fun gaming community for all. No application. No membership. Just fun and friends.
ABOUT_PARAGRAPH_1=Founded in 2015, your community started here. Tell your story.
ABOUT_PARAGRAPH_2=Whatever you play, this is your community.

# Optional web analytics, disabled unless all three are set. Traffic is proxied
# same-origin under /stats, so no CSP change is needed and the browser never
# contacts the analytics host. Point ANALYTICS_HOST at an existing instance on
# any domain (self-hosted or a hosted service, e.g. https://cloud.umami.is).
# Supported providers: umami | plausible. Bare origin, no trailing slash.
#ANALYTICS_PROVIDER=umami
#ANALYTICS_HOST=https://analytics.yourdomain.com
#ANALYTICS_WEBSITE_ID=your-website-id
